PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/aarions

JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_12345!
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_54321!
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
GOOGLE_CLIENT_ID=your_google_client_id_here

# Cors Settings
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Razorpay credentials
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Cloudinary Settings
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Nodemailer Settings (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
FROM_EMAIL=noreply@aarions.com
FROM_NAME="Aarions Organic Products"
